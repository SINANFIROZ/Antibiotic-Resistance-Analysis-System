# Shared
PROJECT_NAME=AMR Intelligence Platform
ENVIRONMENT=development

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/amr_platform
SYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/amr_platform
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT=100/minute
AUTO_CREATE_SCHEMA=true
SEED_REFERENCE_CATALOG=true
INITIAL_ADMIN_EMAIL=admin@amr.local
INITIAL_ADMIN_PASSWORD=ChangeMe123!

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
